{
  "name": "WorldSquad",
  "short_name": "WorldSquad",
  "description": "Vis la FIFA World Cup 2026 — Pronostics, Cartes & Battles entre amis",
  "start_url": "/dashboard",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#0A0A0F",
  "theme_color": "#F5C518",
  "orientation": "portrait-primary",
  "lang": "fr",
  "scope": "/",
  "categories": ["sports", "games", "entertainment"],
  "icons": [
    {
      "src": "/api/icons/192",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/api/icons/512",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/api/icons/512-maskable",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/api/icons/screenshot-mobile",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Dashboard WorldSquad"
    }
  ],
  "shortcuts": [
    {
      "name": "Ouvrir un pack",
      "short_name": "Packs",
      "description": "Ouvre des packs de cartes joueurs",
      "url": "/packs",
      "icons": [{ "src": "/api/icons/192", "sizes": "192x192" }]
    },
    {
      "name": "Mes pronostics",
      "short_name": "Pronostics",
      "description": "Voir les matchs et faire des pronostics",
      "url": "/matches",
      "icons": [{ "src": "/api/icons/192", "sizes": "192x192" }]
    },
    {
      "name": "Ma Collection",
      "short_name": "Collection",
      "description": "Voir ta collection de cartes",
      "url": "/collection",
      "icons": [{ "src": "/api/icons/192", "sizes": "192x192" }]
    }
  ]
}
